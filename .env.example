# Docker Compose reads .env. Never commit real credentials.
APP_PORT=3000
POSTGRES_PASSWORD=local-development-only
MODEL_MODE=mock
# Real mode requires a compatible JSON-schema provider.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_PROTOCOL=json-schema
MODEL_API_KEY=
# Optional China mirrors (uncomment these for future builds).
# Existing official images are reused without a download by default.
# NODE_IMAGE=m.daocloud.io/docker.io/library/node:24-bookworm-slim
# POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:18-bookworm
# NPM_REGISTRY=https://registry.npmmirror.com
# Optional host-side use instead of Compose:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/harness
# TEST_DATABASE_URL=postgresql://test_user:password@127.0.0.1:5432/harness_test

# Server-owned immutable worldview. Bump WORLD_VERSION when content changes.
WORLDVIEW_PATH=mods/qingxi/WORLD.md
WORLD_ID=wuxia
WORLD_VERSION=1
# Set true only behind HTTPS; local HTTP uses false.
COOKIE_SECURE=false
