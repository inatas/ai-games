{
  "name": "game-ai-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:repo": "node scripts/check-repo.mjs",
    "test:unit": "tsx --test packages/core/tests/*.test.ts packages/model/tests/*.test.ts packages/mud-core/tests/*.test.ts",
    "test": "tsx --test --test-concurrency=1 packages/core/tests/*.test.ts packages/model/tests/*.test.ts packages/mud-core/tests/*.test.ts tests/integration/*.test.ts mods/qingxi/tests/*.test.ts",
    "build": "vite build",
    "start": "tsx apps/server/src/main.ts",
    "dev": "docker compose up --build",
    "test:docker": "docker compose --profile test run --build --rm tests",
    "verify": "npm run check && npm run check:repo && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "ajv": "^8.17.1",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  }
}
